; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Şehir Simülasyonu"
config/description="Cities: Skylines 2 mimarisinden ilham alan mobil şehir kurma simülasyonu."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/systems/game_data.gd"
EventBus="*res://scripts/systems/event_bus.gd"
TimeSystem="*res://scripts/systems/time_system.gd"
GraphicsSettings="*res://scripts/systems/graphics_settings.gd"
InputController="*res://scripts/systems/input_controller.gd"
EconomySystem="*res://scripts/systems/economy_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.tr.translation", "res://locale/strings.en.translation")
locale/fallback="tr"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.1, 1)
anti_aliasing/quality/msaa_3d=1

[shader_globals]

night_factor={
"type": "float",
"value": 0.0
}
overlay_dim={
"type": "float",
"value": 0.0
}
